# Telegram Bot API credentials. Use a bot that can read the target group.
TELEGRAM_BOT_TOKEN=replace-me

# Hindsight REST API.
HINDSIGHT_BASE_URL=https://hindsight.130.210.100.165.sslip.io
HINDSIGHT_API_KEY=replace-me
HINDSIGHT_BANK=hermes-telegram-staging

# Local runtime state. Restrict this directory because it contains raw chats.
TELEGRAM_HINDSIGHT_STATE_DIR=$HOME/.local/share/antseed-telegram-hindsight

# Optional. Redact email addresses and phone-like numbers in addition to secrets.
REDACT_CONTACT_INFO=false
